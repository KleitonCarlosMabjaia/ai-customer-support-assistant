# Copia este ficheiro para ".env" e preenche os valores.
# O ficheiro .env está no .gitignore: a tua chave nunca vai para o GitHub.

# Obrigatório: cria a chave em https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=coloca-aqui-a-tua-chave

# Opcionais (estes são os valores por omissão)
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_MAX_TOKENS=16000
# ASSISTANT_TIMEOUT_SECONDS=120
# ASSISTANT_COMPANY_NAME=TechLoja
